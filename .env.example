RADAR_DATA_DIR=.radar/data
SITE_URL=https://liuminxin45.github.io
BASE_PATH=/ai-engineering-radar
# Optional local RSSHub service for CSDN discovery and available full text.
# Start services/rsshub first; CLI variables must be injected by the shell.
RSSHUB_URL=http://127.0.0.1:1200
# Optional service-only outbound proxy. Leave empty for direct access.
RSSHUB_PROXY_URI=
# Optional isolated browser acquisition, used only after CSDN HTTP failure.
BROWSER_FETCH_URL=http://127.0.0.1:1201
# Service-only settings; proxy credentials must remain in the environment.
BROWSER_FETCH_PORT=1201
BROWSER_PROXY_URL=
